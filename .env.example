# ============================================================================
# PATRICK GREY FOREX PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to `.env` (preferably outside the web root, or protected by
# Apache `.htaccess`) and update the values for your local XAMPP or production
# hosting environment. Never commit your real `.env` file to version control.
# ============================================================================

# Application Environment: development | production
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/forex-portfolio
APP_TIMEZONE=Africa/Kampala

# Database Driver: mysql (default for XAMPP/production)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=forex_portfolio
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Optional local fallback for automated CLI testing when MySQL is unavailable
DB_SQLITE_FALLBACK=false
DB_SQLITE_PATH=database/forex_portfolio.sqlite

# Initial Admin Setup Token (used once at /admin/setup.php when 0 admins exist)
ADMIN_SETUP_TOKEN=replace_with_a_random_32_character_setup_token

# Security & Session Settings
SESSION_COOKIE_NAME=pg_forex_sess
SESSION_LIFETIME=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INQUIRY_RATE_LIMIT_SECONDS=60
